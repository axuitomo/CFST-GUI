{
  "name": "cfst-gui-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{ts,json}\"",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"*.ts\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" \"*.ts\" --fix",
    "postinstall": "node ../scripts/patch-android-gradle-warnings.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@phosphor-icons/vue": "^2.2.1",
    "@wailsio/runtime": "3.0.0-beta.16",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "postcss": "8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
