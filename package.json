{
  "name": "cfst-gui",
  "private": true,
  "scripts": {
    "build": "cd frontend && node node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node node_modules/vite/bin/vite.js build",
    "check:vapor": "node scripts/checks/vapor-mode.mjs",
    "dev": "cd frontend && node node_modules/vite/bin/vite.js",
    "wails:dev": "wails3 dev -config build/config/wails.yml",
    "wails:generate": "wails3 generate bindings",
    "format": "cd frontend && node node_modules/oxfmt/bin/oxfmt --write \"src/**/*.{ts,vue,css}\" \"*.{ts,json}\"",
    "format:check": "cd frontend && node node_modules/oxfmt/bin/oxfmt --check \"src/**/*.{ts,vue,css}\" \"*.{ts,json}\"",
    "lint": "cd frontend && node node_modules/oxlint/bin/oxlint --deny-warnings src vite.config.ts capacitor.config.ts",
    "lint:fix": "cd frontend && node node_modules/oxlint/bin/oxlint --deny-warnings --fix src vite.config.ts capacitor.config.ts",
    "lint:root": "node node_modules/oxlint/bin/oxlint --deny-warnings playwright.config.ts tests",
    "lint:md": "markdownlint-cli2",
    "lint:style": "cd frontend && pnpm exec stylelint \"src/**/*.css\"",
    "preview": "cd frontend && node node_modules/vite/bin/vite.js preview",
    "test": "cd frontend && node node_modules/vitest/vitest.mjs run",
    "tsc:ts7": "cd frontend && node node_modules/typescript7/bin/tsc --noEmit",
    "typecheck": "cd frontend && node node_modules/vue-tsc/bin/vue-tsc.js --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "markdownlint-cli2": "^0.23.3",
    "oxlint": "^1.87.0",
    "typescript": "~7.0.2"
  }
}
