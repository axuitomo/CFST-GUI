# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go (gofmt uses tabs)
[*.go]
indent_style = tab
indent_size = 4

# Frontend / web / config files (oxfmt uses 2 spaces)
[*.{ts,tsx,vue,js,jsx,mjs,cjs,css,scss,json,jsonc,html,md,yml,yaml}]
indent_style = space
indent_size = 2

# Shell scripts (line endings come from the global LF rule above)
[*.sh]
indent_style = space
indent_size = 2

# Markdown: preserve intentional trailing spaces (line breaks)
[*.md]
trim_trailing_whitespace = false

# Windows batch scripts (checked out as CRLF, see .gitattributes)
[*.{bat,cmd}]
end_of_line = crlf
