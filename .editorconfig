# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Go (gofmt uses tabs)
[*.go]
indent_style = tab
indent_size = 4

# Frontend / web / config files (Prettier uses 2 spaces)
[*.{ts,tsx,vue,js,jsx,mjs,cjs,css,scss,json,jsonc,html,md,yml,yaml}]
indent_style = space
indent_size = 2

# Shell scripts (project convention: LF, see .gitattributes)
[*.sh]
indent_style = space
indent_size = 2

# Markdown: preserve intentional trailing spaces (line breaks)
[*.md]
trim_trailing_whitespace = false
# Kotlin (ktlint: adapt noisy formatting rules to existing code style; keep naming/blank-line checks) [*.{kt,kts}] indent_style = space indent_size = 4 max_line_length = 160 ktlint_standard_function-signature = disabled ktlint_standard_argument-list-wrapping = disabled ktlint_standard_multiline-expression-wrapping = disabled ktlint_standard_chain-method-continuation = disabled ktlint_standard_function-expression-body = disabled ktlint_standard_parameter-list-wrapping = disabled ktlint_standard_wrapping = disabled ktlint_standard_function-literal = disabled ktlint_standard_class-signature = disabled ktlint_standard_binary-expression-wrapping = disabled ktlint_standard_statement-wrapping = disabled ktlint_standard_spacing-between-declarations-with-annotations = disabled ktlint_standard_indent = disabled ktlint_standard_no-blank-line-before-rbrace = disabled ktlint_standard_function-naming = disabled ktlint_standard_property-naming = disabled
