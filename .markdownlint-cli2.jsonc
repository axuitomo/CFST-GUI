{
  "config": {
    "MD013": false,
    "MD024": false,
    "MD029": false,
    "MD033": false,
    "MD041": false,
    "MD040": false,
    "MD046": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.pnpm-store/**",
    "**/.tmp/**",
    "**/test-results/**",
    "**/cfst-results/**",
    "**/.agents/**",
    "**/.codegraph/**",
    "**/.git/**",
    "**/.idea/**"
  ]
}
