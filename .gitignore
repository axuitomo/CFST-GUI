# Dependencies and package caches
/node_modules/
/frontend/node_modules/
/.pnpm-store/

# Frontend and Wails generated files
# frontend/dist 是 `pnpm build` 的产物，不入库：旧产物一旦被提交，任何「只编译 Go、
# 不重建前端」的路径（go test、gopls、漏跑构建的 CI）都会把陈旧界面 //go:embed 进二进制，
# 表现为「dev/发版之后还是旧前端」。这里只保留 .gitkeep 占位：all: 前缀会纳入点文件，
# 让 //go:embed all:frontend/dist 在全新克隆、尚未构建前端时仍可编译；真正运行/出货前必须先 pnpm build。
dist/
!/frontend/dist/
/frontend/dist/*
!/frontend/dist/.gitkeep
/frontend/.vite/
/frontend/bindings/

# Build and release outputs
/CFST-GUI
/output/
/Releases/
/build/artifacts/
/build/artifacts/release/
/build/bin/
/build/android/
/build/artifacts/webui-linux-amd64/
/build/artifacts/webui-linux-arm64/
/build/validation/
/build/windows/installer/tmp/
/build/windows/installer/wails_tools.nsh
# Windows 版本资源中间产物，必须落在 main 包目录才能被 go build 链接
/wails_windows_*.syso

# 本地设备调试与扫描产物：logcat、截图、报告，不入仓库
/android-logcat.txt
/build/repro-logcat.txt
/build/dropbox.txt
/build/gosec-report.json
/build/clipboard-check.png
/build/device-screen*.png
/build/tmp/
*.exe

# Local runtime data
/result.csv
/internal/app/result.csv
/backups/
/portable/
/data/
/cfst-results/
/internal/appcore/tasks/
/mobileapi/tasks/

# Android generated artifacts
/mobile/android/app/build/
/mobile/android/app/libs/mobileapi*.aar
/mobile/android/app/libs/mobileapi*.jar

# Tests, browser automation, and coverage
/test-results/
/playwright-report/
/blob-report/
/.playwright-cli/
/playwright/.cache/
/playwright/.auth/
coverage/
*.coverprofile
coverage.out

# Local tools and generated toolchains
/.ace-tool/
/.android-toolchain/
/.local/signing/
# 第三方 AI 助手的本地工作目录（记忆/会话数据），不入库
/.workbuddy-ai/

# Environment files and secrets
.env
.env.*
!.env.example
!.env.*.example
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key

# Logs and temporary files
/.tmp/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# OS and IDE files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.iml

# Debug toolchain runtime data (sensitive browser profiles)
/devtools/profiles/

# Debug toolchain third-party runtime libraries (kept on disk, not committed)
/devtools/lib/
